+// EduHPX task log: what the worker threads of one locality do, without a profiler.
+//
+// With HPX_TASK_LOG=<prefix> the task hooks of HPX (lifecycle, causal and work stealing events, they
+// have to be compiled in) are recorded in memory, one buffer per OS thread and no lock on the hot path,
+// and appended in blocks to the binary file <prefix>.tasks.loc<rank>.bin (rank: OMPI_COMM_WORLD_RANK or
+// PMIX_RANK, else 0). HPX_TASK_LOG_SAMPLE=N records every N-th task only (HPX's own 1-in-N sampling, a
+// task that is sampled is recorded completely), HPX_TASK_LOG_MAX_MB (default 2048) caps the file.
+//
+// File: a header of 64 bytes, then records of 32 bytes (struct task_rec), then a table with the names.
+//   header: "EDUHPXK1", u32 version (1), u32 record size (32), i32 rank, i32 pid, u64 offset of the names,
+//           u64 ticks at the start, u64 wall clock ns at the start, u64 ticks at the end, u64 wall ns at the end
+//   The times in the records are ticks of the CPU time stamp counter (rdtsc; ns of CLOCK_MONOTONIC on
+//   other CPUs). The two pairs (ticks, wall clock) turn them into wall clock time.
+//   record: kind, flag, worker, name, t, a, b
+//     1 slice      a task runs on a worker: t = start, b = end, flag = how it ended (0 finished, 1 yielded,
+//                  2 suspended), a = task number, name = what the task is
+//     2 created    a = task number, b = number of the parent task (0: none), name = what the task is
+//     3 suspend    a = task number, name = reason
+//     4 resumed    a = task number, name = what woke it
+//     5 fulfilled  a = id of the future (address of its shared state), b = number of the task that was running (0: none)
+//     6 continuation a = id of the future whose value the continuation uses, b = task that was running
+//     7 stolen     a = task number, worker = thief, b = victim
+//   The number of a task is unique for the whole run (the address of a task is not: HPX reuses its task objects):
+//   (index of the OS thread that created it << 40) | counter of that thread.
+//   names: the description of the task. For an action or a function with a name (hpx::annotated_function) that is
+//   the name; for any other function the address, written as <file>+0x<offset in the file>, to be looked up with
+//   addr2line or nm in that file.
+//   table of names: "EDUHPXN1", u32 count, then per name: u32 id, u16 length, the bytes
+namespace hpx::tracing::detail {
+
+    std::atomic<bool> g_task_log_enabled{std::getenv("HPX_TASK_LOG") != nullptr};
+
+    namespace {
+        enum : std::uint8_t
+        {
+            k_slice = 1,
+            k_created = 2,
+            k_suspend = 3,
+            k_resumed = 4,
+            k_fulfilled = 5,
+            k_continuation = 6,
+            k_stolen = 7,
+            k_parcel_begin = 8,      // a = msb and b = lsb of the id of a parcel: its action starts to run on this worker (name = the action)
+            k_parcel_end = 9,        // the same parcel: the action is done
+            k_parcel_sent = 10,      // a = msb, b = lsb: the running task sends this parcel from this worker
+            k_parcel_sender = 11     // a = lsb of the parcel of the record before, b = number of the task that sends it (0: none)
+        };
+
+        struct task_rec
+        {
+            std::uint8_t kind;
+            std::uint8_t flag;
+            std::uint16_t worker;
+            std::uint32_t name;
+            std::uint64_t t;
+            std::uint64_t a;
+            std::uint64_t b;
+        };
+        static_assert(sizeof(task_rec) == 32);
+
+        inline std::uint64_t task_ticks() noexcept
+        {
+#if defined(__x86_64__) || defined(__i386__)
+            return __rdtsc();
+#else
+            timespec ts;
+            clock_gettime(CLOCK_MONOTONIC, &ts);
+            return static_cast<std::uint64_t>(ts.tv_sec) * 1000000000ULL + static_cast<std::uint64_t>(ts.tv_nsec);
+#endif
+        }
+
+        inline std::uint64_t task_wall_ns() noexcept
+        {
+            timespec ts;
+            clock_gettime(CLOCK_REALTIME, &ts);
+            return static_cast<std::uint64_t>(ts.tv_sec) * 1000000000ULL + static_cast<std::uint64_t>(ts.tv_nsec);
+        }
+
+        // ticks and wall clock at (nearly) the same moment: the best of three tries
+        void task_calibrate(std::uint64_t& ticks, std::uint64_t& wall) noexcept
+        {
+            std::uint64_t best = ~0ULL;
+            for (int i = 0; i != 3; ++i)
+            {
+                std::uint64_t const a = task_ticks();
+                std::uint64_t const w = task_wall_ns();
+                std::uint64_t const b = task_ticks();
+                if (b - a < best)
+                {
+                    best = b - a;
+                    ticks = a + (b - a) / 2;
+                    wall = w;
+                }
+            }
+        }
+
