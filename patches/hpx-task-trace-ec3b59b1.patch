+            bool const enabled = g_task_log_enabled.load();
+            std::uint64_t const max_bytes = max_megabytes() * 1024ULL * 1024ULL;
+
+            // the idle workers of the scheduler run the task "background_work" over and over: without
+            // HPX_TASK_LOG_BACKGROUND those slices are left out, they only fill the file
+            bool const background = std::getenv("HPX_TASK_LOG_BACKGROUND") != nullptr;
+
+            std::mutex mtx;    // guards the file, the names and the counters; the hot path does not take it
+            std::FILE* file = nullptr;
+            std::uint64_t written = 0;
+            std::uint64_t dropped = 0;    // records not written because of the size cap
+
+            // Full blocks of records are handed to a thread of their own that writes them, so that a worker never
+            // waits for the disk. At most max_blocks blocks (64 MB) are kept; if the writer falls behind, the
+            // block that is full is not written (and counted), the worker goes on.
+            struct block
+            {
+                std::size_t n;
+                task_rec rec[block_records];
+            };
+            static constexpr std::size_t max_blocks = TASK_LOG_MAX_BLOCKS;
+            std::mutex qmtx;
+            std::condition_variable qcv;
+            std::deque<block*> queue;
+            std::vector<block*> free_blocks;
+            std::size_t allocated = 0;
+            bool stop = false;
+            std::thread writer;
+            std::atomic<std::uint64_t> dropped_busy{0};    // records not written because the writer was behind
+            std::uint64_t ticks0 = 0, wall0 = 0;
+            std::deque<std::string> names;    // a deque: the strings do not move, the threads keep pointers to them
+            std::unordered_map<std::string, std::uint32_t> index;
+
+            static std::uint64_t max_megabytes()
+            {
+                char const* mb = std::getenv("HPX_TASK_LOG_MAX_MB");
+                long const v = mb != nullptr ? std::atol(mb) : 0;
+                return v > 0 ? static_cast<std::uint64_t>(v) : 2048;
+            }
+
+            task_log_t()
+            {
+                if (enabled)
+                    task_calibrate(ticks0, wall0);
+            }
+
+            std::uint32_t intern_slow(char const* s, char const*& stable)
+            {
+                std::lock_guard<std::mutex> l(mtx);
+                auto it = index.find(s);
+                if (it == index.end())
+                {
+                    names.emplace_back(s);
+                    it = index.emplace(names.back(), static_cast<std::uint32_t>(names.size() - 1)).first;
+                }
+                stable = names[it->second].c_str();
+                return it->second;
+            }
+
+            static int rank()
+            {
+                char const* r = std::getenv("OMPI_COMM_WORLD_RANK");
+                if (r == nullptr)
+                    r = std::getenv("PMIX_RANK");
+                return r != nullptr ? std::atoi(r) : 0;
+            }
+
+            // caller holds mtx
+            bool open_file()
+            {
+                std::string const name =
+                    std::string(std::getenv("HPX_TASK_LOG")) + ".tasks.loc" + std::to_string(rank()) + ".bin";
+                file = std::fopen(name.c_str(), "wb");
+                if (file == nullptr)
+                {
+                    std::fprintf(stderr, "HPX task log: cannot open %s, events are dropped\n", name.c_str());
+                    return false;
+                }
+                static char buffer[1 << 20];
+                std::setvbuf(file, buffer, _IOFBF, sizeof(buffer));
+                char header[64] = {};
+                std::fwrite(header, 1, sizeof(header), file);    // filled in when the file is closed
+                written = sizeof(header);
+                return true;
+            }
+
+            void write_block(task_rec const* r, std::size_t n)
+            {
+                std::lock_guard<std::mutex> l(mtx);
+                if (written >= max_bytes || (file == nullptr && !open_file()))
+                {
+                    dropped += n;
+                    written = max_bytes;
+                    return;
+                }
+                std::fwrite(r, sizeof(task_rec), n, file);
+                written += n * sizeof(task_rec);
+            }
+
+            // a block for a worker, nullptr if the writer is behind
+            block* acquire()
+            {
+                std::lock_guard<std::mutex> l(qmtx);
+                if (!free_blocks.empty())
+                {
+                    block* b = free_blocks.back();
+                    free_blocks.pop_back();
+                    return b;
+                }
+                if (allocated < max_blocks)
+                {
+                    ++allocated;
+                    return new block;
+                }
+                return nullptr;
+            }
+
+            void release(block* b)
+            {
+                std::lock_guard<std::mutex> l(qmtx);
+                free_blocks.push_back(b);
+            }
+
+            // b->n records are in b: the writer takes it (and gives it back when it is written)
+            void submit(block* b)
+            {
+                {
+                    std::lock_guard<std::mutex> l(qmtx);
+                    if (stop)    // the log is closed already: a thread that outlives the program
+                    {
+                        free_blocks.push_back(b);
+                        return;
+                    }
+                    queue.push_back(b);
+                    if (!writer.joinable())
+                        writer = std::thread([this] { writer_loop(); });
+                }
+                qcv.notify_one();
+            }
+
+            void writer_loop()
+            {
+                std::unique_lock<std::mutex> l(qmtx);
+                for (;;)
+                {
+                    qcv.wait(l, [this] { return !queue.empty() || stop; });
+                    if (queue.empty())
+                        break;    // closed and everything is written
+                    block* b = queue.front();
+                    queue.pop_front();
+                    l.unlock();
+                    write_block(b->rec, b->n);
+                    l.lock();
+                    free_blocks.push_back(b);
+                }
+            }
+
+            ~task_log_t()
+            {
+                close();
+            }
+
+            // end of the program: write what is queued, then the names and the header
+            void close()
+            {
+                if (!enabled)
+                    return;
+                {
+                    std::lock_guard<std::mutex> l(qmtx);
+                    if (stop)
+                        return;
+                    stop = true;
+                }
+                qcv.notify_all();
+                if (writer.joinable())
+                    writer.join();
+                std::lock_guard<std::mutex> l(mtx);
+                if (file != nullptr)
+                {
+                    std::uint64_t const names_at = static_cast<std::uint64_t>(ftello(file));
+                    std::fwrite("EDUHPXN1", 1, 8, file);
+                    std::uint32_t const count = static_cast<std::uint32_t>(names.size());
+                    std::fwrite(&count, 4, 1, file);
+                    for (std::uint32_t id = 0; id != count; ++id)
+                    {
+                        std::uint16_t const len = static_cast<std::uint16_t>(std::min<std::size_t>(names[id].size(), 65535));
+                        std::fwrite(&id, 4, 1, file);
+                        std::fwrite(&len, 2, 1, file);
+                        std::fwrite(names[id].data(), 1, len, file);
+                    }
+                    std::uint64_t ticks1 = 0, wall1 = 0;
+                    task_calibrate(ticks1, wall1);
+                    unsigned char header[64] = {};
+                    std::memcpy(header, "EDUHPXK1", 8);
+                    std::uint32_t const version = 1, rec_size = sizeof(task_rec);
+                    std::int32_t const rk = rank();
+#if !defined(_WIN32)
+                    std::int32_t const pid = static_cast<std::int32_t>(getpid());
+#else
+                    std::int32_t const pid = 0;
+#endif
+                    std::memcpy(header + 8, &version, 4);
+                    std::memcpy(header + 12, &rec_size, 4);
+                    std::memcpy(header + 16, &rk, 4);
+                    std::memcpy(header + 20, &pid, 4);
+                    std::memcpy(header + 24, &names_at, 8);
+                    std::memcpy(header + 32, &ticks0, 8);
+                    std::memcpy(header + 40, &wall0, 8);
+                    std::memcpy(header + 48, &ticks1, 8);
+                    std::memcpy(header + 56, &wall1, 8);
+                    fseeko(file, 0, SEEK_SET);
+                    std::fwrite(header, 1, sizeof(header), file);
+                    std::fclose(file);
+                }
+                if (dropped != 0)
+                    std::fprintf(stderr,
+                        "HPX task log: size cap of %llu MB reached, %llu records were dropped (raise HPX_TASK_LOG_MAX_MB)\n",
+                        (unsigned long long) (max_bytes >> 20), (unsigned long long) dropped);
+                if (dropped_busy.load() != 0)
+                    std::fprintf(stderr,
+                        "HPX task log: the disk was too slow, %llu records were dropped (use a faster disk, a local one, "
+                        "or HPX_TASK_LOG_SAMPLE=N)\n",
+                        (unsigned long long) dropped_busy.load());
+            }
+        };
+
+        // the log lives until the program ends; at exit it is closed in an orderly way (threads that run longer
+        // find it closed and drop their records)
+        task_log_t* g_task_log = nullptr;
+
+        task_log_t& task_log()
+        {
+            static task_log_t* const log = [] {
+                auto* p = new task_log_t;
+                g_task_log = p;
+                if (p->enabled)
+                    std::atexit([] {
+                        if (g_task_log != nullptr)
+                            g_task_log->close();
+                    });
+                return p;
+            }();
+            return *log;
+        }
+
+        // Is this the address of code? HPX names a task without a name by "the address of the function", but for
+        // a lambda it gives the address of the closure object (on a stack or the heap), different for every task.
+        // The executable parts of the loaded files are listed once (no lock afterwards, a binary search).
+        struct code_ranges
+        {
+            std::vector<std::pair<std::uintptr_t, std::uintptr_t>> r;
+
+            code_ranges()
+            {
+#if !defined(_WIN32)
+                dl_iterate_phdr(
+                    [](dl_phdr_info* info, std::size_t, void* data) -> int {
+                        auto* self = static_cast<code_ranges*>(data);
+                        for (int i = 0; i != info->dlpi_phnum; ++i)
+                        {
+                            ElfW(Phdr) const& ph = info->dlpi_phdr[i];
+                            if (ph.p_type == PT_LOAD && (ph.p_flags & PF_X) != 0)
+                                self->r.emplace_back(info->dlpi_addr + ph.p_vaddr, info->dlpi_addr + ph.p_vaddr + ph.p_memsz);
+                        }
+                        return 0;
+                    },
+                    this);
+                std::sort(r.begin(), r.end());
+#endif
+            }
+
+            bool contains(std::uintptr_t a) const noexcept
+            {
+                auto it = std::upper_bound(r.begin(), r.end(), std::make_pair(a, ~std::uintptr_t{0}));
+                if (it == r.begin())
+                    return false;
+                --it;
+                return a >= it->first && a < it->second;
+            }
+        };
+
+        bool is_code_address(std::size_t addr)
+        {
+            static code_ranges const ranges;
+            return ranges.contains(addr);
+        }
+
+        // a function address as text: the name of the function if the file exports it, else <file>+0x<offset>
+        std::string describe_address(std::size_t addr)
+        {
+#if !defined(_WIN32)
+            Dl_info info;
+            if (dladdr(reinterpret_cast<void const*>(addr), &info) != 0)
+            {
+                if (info.dli_sname != nullptr)
+                {
+                    int status = 0;
+                    char* demangled = abi::__cxa_demangle(info.dli_sname, nullptr, nullptr, &status);
+                    std::string name = (status == 0 && demangled != nullptr) ? demangled : info.dli_sname;
+                    std::free(demangled);
+                    return name;
+                }
+                if (info.dli_fname != nullptr)
+                {
+                    char buf[32];
+                    std::snprintf(buf, sizeof(buf), "+0x%zx", addr - reinterpret_cast<std::size_t>(info.dli_fbase));
+                    return std::string(info.dli_fname) + buf;
+                }
+            }
+#endif
+            char buf[32];
+            std::snprintf(buf, sizeof(buf), "0x%zx", addr);
+            return buf;
+        }
+
+        // what one OS thread keeps: the records not written yet, the tasks it is running (a task can run
+        // another one inside, so a small stack), and a cache from the address of a description to its number
+        struct task_tls
+        {
+            static constexpr std::size_t capacity = block_records;
+            static constexpr int max_depth = 8;
+
+            task_log_t::block* cur = nullptr;    // the block that is filled
+            std::uint32_t n = 0;
+
+            struct frame
+            {
+                std::uint64_t task;
+                std::uint64_t start;
+                std::uint32_t name;
+                bool skip;    // a task that is not recorded
+            };
+            frame stack[max_depth];
+            int depth = 0;
+            std::uint16_t worker = 0xFFFF;
+
+            struct cache_entry
+            {
+                char const* key;
+                std::size_t addr;
+                char const* stable;
+                std::uint32_t id;
+                bool skip;
+            };
+            cache_entry cache[256] = {};
+
+            ~task_tls()
+            {
+                if (cur == nullptr)
+                    return;
+                if (n != 0)
+                {
+                    cur->n = n;
+                    task_log().submit(cur);
+                }
+                else
+                    task_log().release(cur);
+                cur = nullptr;
+            }
+
+            void push(task_rec const& r)
+            {
+                if (cur == nullptr && (cur = task_log().acquire()) == nullptr)
+                {
+                    task_log().dropped_busy.fetch_add(1, std::memory_order_relaxed);
+                    return;
+                }
+                cur->rec[n++] = r;
+                if (n == capacity)
+                {
+                    task_log_t::block* next = task_log().acquire();
+                    if (next == nullptr)    // the writer is behind: this block is not written, the buffer is used again
+                    {
+                        task_log().dropped_busy.fetch_add(n, std::memory_order_relaxed);
+                        n = 0;
+                        return;
+                    }
+                    cur->n = n;
+                    task_log().submit(cur);
+                    cur = next;
+                    n = 0;
+                }
+            }
+
+            // descriptions are mostly string literals: the address finds the number, a compare makes sure
+            // that the address was not used for another text meanwhile
+            std::uint32_t intern(char const* s)
+            {
+                bool skip = false;
+                return intern(s, skip);
+            }
+
+            // skip is set for tasks that are not recorded (the idle loop of the scheduler)
+            std::uint32_t intern(char const* s, bool& skip)
+            {
+                if (s == nullptr)
+                    s = "<none>";
+                cache_entry& e = cache[(reinterpret_cast<std::uintptr_t>(s) >> 3) & 255];
+                if (e.key == s && e.addr == 0 && e.stable != nullptr && std::strcmp(e.stable, s) == 0)
+                {
+                    skip = e.skip;
+                    return e.id;
+                }
+                char const* stable = nullptr;
+                std::uint32_t const id = task_log().intern_slow(s, stable);
+                skip = !task_log().background && std::strcmp(stable, "background_work") == 0;
+                e = {s, 0, stable, id, skip};
+                return id;
+            }
+
+            // a task without a name: the address of its function (the same address always gives the same number)
+            std::uint32_t intern_address(std::size_t addr)
+            {
+                cache_entry& e = cache[(addr >> 4) & 255];
+                if (e.key == nullptr && e.addr == addr && e.stable != nullptr)
+                    return e.id;
+                char const* stable = nullptr;
+                std::uint32_t const id = task_log().intern_slow(describe_address(addr).c_str(), stable);
+                e = {nullptr, addr, stable, id, false};
+                return id;
+            }
+
+            std::uint32_t name_of(char const* name, std::size_t addr, bool& skip)
+            {
+                skip = false;
+                // some tasks hand over the address of their code where a name should be: that is no text
+                if (name != nullptr && is_code_address(reinterpret_cast<std::size_t>(name)))
+                {
+                    addr = reinterpret_cast<std::size_t>(name);
+                    name = nullptr;
+                }
+                if (name != nullptr)
+                    return intern(name, skip);
+                if (addr != 0 && is_code_address(addr))    // a function
+                    return intern_address(addr);
+                return intern("<unnamed task>");           // a lambda: HPX does not tell what it is
+            }
+
+            std::uint64_t running() const noexcept
+            {
+                return (depth > 0 && depth <= max_depth) ? stack[depth - 1].task : 0;
+            }
+        };
+
+        // not inlined: the address of the thread_local has to be looked up at every call, a task can
+        // continue on another worker thread after it was suspended
+        HPX_NOINLINE task_tls& tls()
+        {
+            thread_local task_tls state;
+            return state;
+        }
+    }    // namespace
+
+    std::uint64_t task_log_new_serial() noexcept
+    {
+        static std::atomic<std::uint64_t> next_thread{1};
+        thread_local std::uint64_t const thread_index = next_thread.fetch_add(1, std::memory_order_relaxed);
+        thread_local std::uint64_t counter = 0;
+        return (thread_index << 40) | ++counter;
+    }
+
+    std::uint64_t task_log_running_serial() noexcept
+    {
+        return tls().running();
+    }
+
+    HPX_CORE_EXPORT void task_log_parcel_exec(bool begin, std::uint64_t msb, std::uint64_t lsb, char const* action) noexcept;
+    HPX_CORE_EXPORT void task_log_parcel_sent(std::uint64_t msb, std::uint64_t lsb) noexcept;
+
+    void task_log_parcel_exec(bool begin, std::uint64_t msb, std::uint64_t lsb, char const* action) noexcept
+    {
+        task_tls& s = tls();
+        bool skip = false;
+        std::uint32_t const id = begin && action != nullptr ? s.intern(action, skip) : 0;
+        s.push({begin ? k_parcel_begin : k_parcel_end, 0, s.worker, id, task_ticks(), msb, lsb});
+    }
+
+    void task_log_parcel_sent(std::uint64_t msb, std::uint64_t lsb) noexcept
+    {
+        task_tls& s = tls();
+        std::uint64_t const now = task_ticks();
+        s.push({k_parcel_sent, 0, s.worker, 0, now, msb, lsb});
+        s.push({k_parcel_sender, 0, s.worker, 0, now, lsb, s.running()});
+    }
+
+    void task_log_created(std::uint64_t serial, std::uint64_t parent, char const* name, std::size_t addr) noexcept
+    {
+        task_tls& s = tls();
+        bool skip = false;
+        std::uint32_t const id = s.name_of(name, addr, skip);
+        // HPX tells the parent only if it was built with HPX_WITH_THREAD_DEBUG_INFO; the parent is the task that is running
+        // on this thread now (it called async, dataflow, ...), and the recorder knows that one
+        if (!skip)
+            s.push({k_created, 0, s.worker, id, task_ticks(), serial, parent != 0 ? parent : s.running()});
+    }
+
+    void task_log_executing(std::uint64_t serial, char const* name, std::size_t addr, std::size_t worker) noexcept
+    {
+        task_tls& s = tls();
+        s.worker = static_cast<std::uint16_t>(worker);
+        bool skip = false;
+        std::uint32_t const id = s.name_of(name, addr, skip);
+        if (s.depth < task_tls::max_depth)
+            s.stack[s.depth] = {serial, skip ? 0 : task_ticks(), id, skip};
+        ++s.depth;
+    }
+
+    // the slice of a task ends: it finished (0), yielded (1) or suspended (2)
+    void task_log_ended(std::uint64_t serial, std::uint8_t how, char const* reason) noexcept
+    {
+        task_tls& s = tls();
+        if (s.depth <= 0)
+            return;
+        --s.depth;
+        if (s.depth < task_tls::max_depth && s.stack[s.depth].skip)
+            return;    // not recorded: no slice, no suspend
+        std::uint64_t const end = task_ticks();
+        if (s.depth < task_tls::max_depth && s.stack[s.depth].task == serial)
+        {
+            auto const& f = s.stack[s.depth];
+            s.push({k_slice, how, s.worker, f.name, f.start, f.task, end});
+        }
+        if (how == 2)
+            s.push({k_suspend, 0, s.worker, s.intern(reason), end, serial, 0});
+    }
+
+    void task_log_resumed(std::uint64_t serial, char const* wake_reason) noexcept
+    {
+        task_tls& s = tls();
+        s.push({k_resumed, 0, s.worker, s.intern(wake_reason), task_ticks(), serial, 0});
+    }
+
+    void task_log_future_fulfilled(void const* future_id) noexcept
+    {
+        task_tls& s = tls();
+        s.push({k_fulfilled, 0, s.worker, 0, task_ticks(), reinterpret_cast<std::uint64_t>(future_id), s.running()});
+    }
+
+    void task_log_continuation_run(void const* future_id) noexcept
+    {
+        task_tls& s = tls();
+        s.push({k_continuation, 0, s.worker, 0, task_ticks(), reinterpret_cast<std::uint64_t>(future_id), s.running()});
+    }
+
+    void task_log_work_stolen(std::size_t thief, std::size_t victim, std::uint64_t serial) noexcept
+    {
+        task_tls& s = tls();
+        s.push({k_stolen, 0, static_cast<std::uint16_t>(thief), 0, task_ticks(), serial, victim});
+    }
+
+}    // namespace hpx::tracing::detail
+
 #endif
