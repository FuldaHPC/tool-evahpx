#!/usr/bin/env python3
"""evahpx-tasks RUN_DIR|FILE... [-o tasks.csv] [--run NAME] [--min-us N]

Makes the task file of EvaHPX (CSV, see docs/task_file_format.md) out of the task logs of HPX (HPX_TASK_LOG, see
docs/task_log_format.md): one row for every time a task ran on a worker thread, and the links between the tasks.
  RUN_DIR      the run directory of evahpx-run: all <prefix>.tasks.loc<rank>.bin in it. If it holds clock_offsets.csv and the
               MPI logs (eduhpx.mpi.<rank>.bin) the times of the other nodes are corrected, as evahpx-merge does for run.csv
  FILE...      task logs; --clock-offsets FILE and --nodes 0=nodeA,1=nodeB can give the corrections by hand
Standard library only."""
import argparse
import bisect
import csv
import glob
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import evahpx_tasklog as tl  # noqa: E402


def node_of_rank(run_dir, rank):
    """Name of the node of a locality, from the header of its MPI log (bytes 24 to 56)."""
    path = os.path.join(run_dir, "eduhpx.mpi.%d.bin" % rank)
    try:
        with open(path, "rb") as f:
            head = f.read(64)
        return head[24:56].split(b"\0")[0].decode() if head[:8] == b"EDUHPXM1" else None
    except OSError:
        return None


def read_offsets(path):
    offsets = {}
    with open(path) as f:
        for line in f:
            f_ = line.strip().split(",")
            if len(f_) == 3 and f_[0] != "node":
                offsets[f_[0]] = float(f_[2])
    return offsets


def us(v):
    return ("%.3f" % v).rstrip("0").rstrip(".")


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("inputs", nargs="+")
    ap.add_argument("-o", "--output", help="task file (default: RUN_DIR/tasks.csv, or tasks.csv)")
    ap.add_argument("--run", default="", help="name shown in the viewer")
    ap.add_argument("--min-us", type=float, default=0.0, help="leave out the slices shorter than this (microseconds)")
    ap.add_argument("--clock-offsets", help="clock_offsets.csv (node,index,offset_us)")
    ap.add_argument("--nodes", default="", help="the node of every locality: 0=compute-00,1=compute-01,...")
    a = ap.parse_args()

    run_dir = None
    paths = []
    for p in a.inputs:
        if os.path.isdir(p):
            run_dir = os.path.abspath(p)
            paths += sorted(glob.glob(os.path.join(run_dir, "*.tasks.loc*.bin")))
        else:
            paths.append(p)
    if not paths:
        sys.exit("evahpx-tasks: no task logs (*.tasks.loc<rank>.bin) found")
    out = a.output or os.path.join(run_dir or ".", "tasks.csv")
    name = a.run or (os.path.basename(run_dir) if run_dir else os.path.basename(out))
    offsets = {}
    if a.clock_offsets:
        offsets = read_offsets(a.clock_offsets)
    elif run_dir and os.path.exists(os.path.join(run_dir, "clock_offsets.csv")):
        offsets = read_offsets(os.path.join(run_dir, "clock_offsets.csv"))
    nodes = dict((int(k), v) for k, v in (x.split("=") for x in a.nodes.split(",") if "=" in x))

    rows, deps, steals, parcels, wakes = [], [], [], [], []      # parcels: (loc, worker, 'send'/'recv', task, name, t0, t1, parcel id)
    n_tasks = n_slices = 0
    workers = {}
    for path in paths:
        log = tl.read(path)
        loc = log.rank
        node = nodes.get(loc) or (node_of_rank(run_dir, loc) if run_dir else None)
        off = offsets.get(node, 0.0) if node else 0.0
        wall = lambda t: log.wall_us(t) + off  # noqa: E731
        # task numbers are unique within a process only: the locality goes into the upper bits (the thread index of the log takes bits 40-51)
        gid = lambda x: (x | (loc << 52)) if x else 0  # noqa: E731
        recs = sorted(log.records, key=lambda r: r[4])    # in time order
        created = {}                                      # task -> (time, parent, name)
        last_fulfilled = {}                               # future -> (time, task)
        fulfilled_on = {}                                 # future -> (time, worker): where a value was set
        waits = []                                        # (time, worker, future, task): a task is about to block on a future
        starts = {}                                       # task -> [(start, worker)] of its slices
        for kind, flag, worker, nid, t, x, y in recs:
            if kind == 2:
                created.setdefault(x, (wall(t), y, log.name(nid)))
            elif kind == 5:
                last_fulfilled[x] = (wall(t), y)
                fulfilled_on[x] = (wall(t), worker)
            elif kind == 12:
                waits.append((wall(t), worker, x, y))
            elif kind == 6:
                f = last_fulfilled.get(x)
                if f is not None and f[1] and y and f[1] != y:
                    deps.append((loc, gid(f[1]), gid(y), f[0], wall(t)))
            elif kind == 7:
                steals.append((loc, worker, y, gid(x), wall(t)))
        # parcels: an action that runs right away on the receiving worker (a direct action), and the task that sends a parcel
        begun, sent = {}, {}
        n_direct = 0
        for kind, flag, worker, nid, t, x, y in recs:
            if kind == 8:
                begun[(x, y)] = (wall(t), worker, nid)
            elif kind == 9 and (x, y) in begun:
                t0, wk, nm = begun.pop((x, y))
                n_direct += 1
                task = (1 << 51) | n_direct                       # no number from HPX: it is no task, make one
                rows.append((loc, wk, gid(task), log.name(nm), t0, wall(t), "finished", 0, None))
                parcels.append((loc, wk, "recv", gid(task), log.name(nm), t0, wall(t), "%016x:%016x" % (x, y)))
                n_slices += 1
            elif kind == 10:
                sent[y] = (wall(t), worker, x)
            elif kind == 11 and x in sent:
                t0, wk, msb = sent.pop(x)
                parcels.append((loc, wk, "send", gid(y), "", t0, "", "%016x:%016x" % (msb, x)))
        seen = set()
        for kind, flag, worker, nid, t, x, y in recs:
            if kind != 1:
                continue
            t0, t1 = wall(t), wall(y)
            if t1 - t0 < a.min_us:
                continue
            c = created.get(x)
            rows.append((loc, worker, gid(x), log.name(nid), t0, t1, tl.ENDS.get(flag, "?"), gid(c[1]) if c else 0, c[0] if c else None))
            starts.setdefault(x, []).append((t0, worker))
            workers.setdefault(loc, set()).add(worker)
            seen.add(x)
            n_slices += 1
        # a value that was set on one worker thread wakes a task that goes on on another one: the communication inside the locality
        for tw, wk, fut, task in waits:
            f = fulfilled_on.get(fut)
            if not task or f is None or f[0] < tw - 5:
                continue
            nxt = [st for st in starts.get(task, []) if st[0] >= f[0]]
            if nxt:
                t_next, wx = min(nxt)
                wakes.append((loc, f[1], gid(task), f[0], t_next, wx))
        n_tasks += len(seen)
        if not log.complete:
            print("evahpx-tasks: %s was not closed (no names, times not calibrated)" % path, file=sys.stderr)

    rows.sort(key=lambda r: (r[0], r[1], r[4]))
    with open(out, "w", newline="") as f:
        f.write("# evahpx_tasks_csv 1\n")
        f.write("# run=%s localities=%d tasks=%d slices=%d deps=%d steals=%d\n" % (
            name.replace(" ", "_"), len(workers), n_tasks, n_slices, len(deps), len(steals)))
        w = csv.writer(f, lineterminator="\n")
        w.writerow(["kind", "loc", "worker", "task", "name", "t0", "t1", "end", "parent", "created", "peer"])
        for loc, worker, task, nm, t0, t1, end, parent, created in rows:
            w.writerow(["slice", loc, worker, task, nm, us(t0), us(t1), end, parent or "", us(created) if created else "", ""])
        for loc, frm, to, t0, t1 in deps:
            w.writerow(["dep", loc, "", frm, "", us(t0), us(t1), "", "", "", to])
        for loc, thief, victim, task, t in steals:
            w.writerow(["steal", loc, thief, task, "", us(t), "", "", "", "", victim])
        for loc, wf, task, tf, tn, wx in wakes:                    # a value set on worker wf woke the task, which went on on worker wx
            w.writerow(["wake", loc, wf, task, "", us(tf), us(tn), "", "", "", wx])
        for loc, wk, what, task, nm, t0, t1, pid in parcels:      # which thread sent / ran the action of which parcel (the id as in run.csv)
            w.writerow([what, loc, wk, task or "", nm, us(t0), us(t1) if t1 != "" else "", "", "", "", pid])
    print("evahpx-tasks: %s: %d localities, %d tasks in %d slices, %d dependencies, %d steals, %d parcel records, %d wake-ups" % (
        out, len(workers), n_tasks, n_slices, len(deps), len(steals), len(parcels), len(wakes)))


if __name__ == "__main__":
    main()
